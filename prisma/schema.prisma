// Oi Dulavai (ঐ দুলাভাই) - Luxury Menswear Atelier
// Enterprise Database Schema with Strict Typing & Relational Integrity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  passwordHash  String
  role          String    @default("CUSTOMER") // CUSTOMER, SUPPORT_AGENT, INVENTORY_MANAGER, SUPER_ADMIN
  vaultId       String?   @unique // e.g. SOV-BANANI-409
  tier          String    @default("Sovereign Patron")
  loyaltyPoints Int       @default(1250)
  currency      String    @default("BDT")
  language      String    @default("EN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  measurements  MeasurementVault?
  appointments  BespokeAppointment[]

  @@index([role])
  @@index([email])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   // e.g. "Primary Residence", "Banani Atelier Office", "Sylhet Manor"
  recipientName String
  phone         String
  street        String
  area          String   // e.g. "Banani Road 11", "Gulshan 2"
  city          String   @default("Dhaka")
  division      String   @default("Dhaka")
  postalCode    String   @default("1213")
  country       String   @default("Bangladesh")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model MeasurementVault {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collar           Float     @default(15.5)
  chest            Float     @default(40.0)
  waist            Float     @default(34.0)
  shoulder         Float     @default(18.0)
  sleeve           Float     @default(25.5)
  bicep            Float     @default(14.5)
  inseam           Float     @default(31.0)
  kurtaLength      Float     @default(42.0)
  monogramInitials String?   @default("AMC")
  monogramThread   String?   @default("ANTIQUE_GOLD") // ANTIQUE_GOLD, STERLING_SILVER, TONE_ON_TONE
  monogramPlacement String?  @default("CUFF") // CUFF, PLACKET_BASE, CHEST_POCKET
  tailorNotes      String?   @default("Prefers architectural slim drape with 1.5 inch ease across shoulder blades.")
  lastFittedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique // e.g. PRD-101
  name            String
  slug            String           @unique
  bengaliName     String?
  subtitle        String?
  description     String
  editorialStory  String?
  category        String           // Panjabi, Waskoti, Sherwani, Trousers, Accessories
  fabric          String           // Rajshahi Raw Silk, Irish Linen, Barendra Khadi, etc.
  weaveOrigin     String           // Rajshahi Mulberry Sericulture, Tangail Handlooms
  gsm             Int?
  basePrice       Int              // Price in BDT
  costPrice       Int              // Internal cost for gross margin analytics
  compareAtPrice  Int?
  isFeatured      Boolean          @default(false)
  isTrending      Boolean          @default(false)
  isImmediateStock Boolean         @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  variants        ProductVariant[]
  images          ProductImage[]
  hotspots        ProductHotspot[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([category])
  @@index([isFeatured])
  @@index([isTrending])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String      @unique // e.g. PRD-101-40-MUSTARD
  size              String      // 38, 40, 42, 44, 46, Bespoke
  color             String
  colorHex          String?
  priceAdjustment   Int         @default(0)
  inventoryCount    Int         @default(12)
  lowStockThreshold Int         @default(3)
  barcode           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orderItems        OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([inventoryCount])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  viewType  String   @default("front") // front, detail, back, drape, lookbook
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductHotspot {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  spec      String
  xPos      Float    // percentage 0-100
  yPos      Float    // percentage 0-100

  @@index([productId])
}

model Order {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique // e.g. OD-DHAKA-8492
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  patronName         String
  patronEmail        String
  patronPhone        String
  shippingAddress    String
  shippingCity       String             @default("Dhaka")
  shippingZone       String             @default("Banani / Gulshan / Uttara Metro Express")
  dispatchMethod     String             @default("EXPRESS_CHAUFFEUR") // EXPRESS_CHAUFFEUR, STANDARD_NEXT_DAY, ATELIER_PICKUP
  doorstepTailorTrial Boolean           @default(true)
  status             String             @default("CONFIRMED") // PENDING, CONFIRMED, PACKAGING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus      String             @default("PAID") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod      String             @default("BKASH") // BKASH, NAGAD, CARD, COD
  paymentTxnId       String?
  subtotal           Int
  discountAmount     Int                @default(0)
  vatAmount          Int                @default(0) // 7.5%
  shippingFee        Int                @default(0)
  totalAmount        Int
  currency           String             @default("BDT")
  couponCode         String?
  chauffeurName      String?            @default("Kabir Hossain")
  chauffeurVehicle   String?            @default("Mercedes-Benz Sprinter Atelier Van • Chha 11-4920")
  chauffeurPhone     String?            @default("+880 1711-449200")
  trackingNode       String?            @default("MOHAKHALI_JUNCTION") // ORIGIN_TEJGAON, MOHAKHALI_JUNCTION, BANANI_ARRIVING, DELIVERED
  etaText            String?            @default("Today, 7:30 PM (Guaranteed)")
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]

  @@index([orderNumber])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title          String
  sku            String
  size           String
  color          String?
  unitPrice      Int
  quantity       Int             @default(1)
  subtotal       Int
  monogramText   String?
  monogramThread String?
  textileSpec    String?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  title     String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue  Int       @default(10) // 10% or fixed BDT
  minOrderAmount Int       @default(0)
  maxDiscount    Int?
  usageLimit     Int?      @default(500)
  usageCount     Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([code])
}

model BespokeAppointment {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patronName      String
  phone           String
  email           String
  salonLocation   String   // BANANI_11_FLAGSHIP, SYLHET_ARTISANAL_SUITE, PRIVATE_RESIDENCE
  occasion        String   // ROYAL_WEDDING, CEREMONIAL_EID, WARDROBE_COMMISSION, OTHER
  appointmentDate String
  timeSlot        String
  partySize       Int      @default(1)
  notes           String?
  status          String   @default("CONFIRMED")
  createdAt       DateTime @default(now())

  @@index([appointmentDate])
  @@index([userId])
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName  String
  authorTitle String?  // e.g. "Banani Patron", "Groom • Gulshan Club"
  rating      Int      @default(5)
  comment     String
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // e.g. "UPDATED_ORDER_STATUS", "RESTOCKED_VARIANT", "CREATED_PROMOTION"
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
