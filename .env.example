# ========================================================
# Oi Dulavai — Environment Configuration
# ========================================================

# Database Connection:
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Vercel Production (Postgres / Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_PRISMA_URL="postgresql://..." # Automatically supported if using Vercel Postgres

# Security & Authentication (Required):
JWT_SECRET="generate_a_minimum_32_char_cryptographic_secret_here"
ADMIN_SECRET="secure_salt_key_for_executive_admin_guard_2025"
CRON_SECRET="secure_random_token_for_courier_webhook_auth"

# Application URL:
NEXT_PUBLIC_APP_URL="https://your-deployment.vercel.app" # Or http://localhost:3000 locally
NODE_ENV="production"
